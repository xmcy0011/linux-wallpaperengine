/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

IDR_MAINFRAME           ICON                    "res\\demo_mfc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Set &Assets Path...",          IDM_FILE_SET_ASSETS
        MENUITEM "&Load Wallpaper...",            IDM_FILE_LOAD_WALLPAPER
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                         IDM_FILE_EXIT
    END
    POPUP "&Playback"
    BEGIN
        MENUITEM "&Play",                         IDM_PLAYBACK_PLAY
        MENUITEM "&Pause",                        IDM_PLAYBACK_PAUSE
        MENUITEM "&Stop",                         IDM_PLAYBACK_STOP
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Control Panel",                IDM_VIEW_CONTROLPANEL
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                     IDM_HELP_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS
BEGIN
    "N",            IDM_FILE_NEW,            VIRTKEY, CONTROL
    "O",            IDM_FILE_OPEN,           VIRTKEY, CONTROL
    "S",            IDM_FILE_SAVE,           VIRTKEY, CONTROL
    "P",            IDM_FILE_PRINT,          VIRTKEY, CONTROL
    "Z",            IDM_EDIT_UNDO,           VIRTKEY, CONTROL
    "X",            IDM_EDIT_CUT,            VIRTKEY, CONTROL
    "C",            IDM_EDIT_COPY,           VIRTKEY, CONTROL
    "V",            IDM_EDIT_PASTE,          VIRTKEY, CONTROL
    VK_BACK,        IDM_EDIT_UNDO,           VIRTKEY, ALT
    VK_DELETE,      IDM_EDIT_CUT,            VIRTKEY, SHIFT
    VK_INSERT,      IDM_EDIT_COPY,           VIRTKEY, CONTROL
    VK_INSERT,      IDM_EDIT_PASTE,          VIRTKEY, SHIFT
    VK_F6,          IDM_NEXT_PANE,           VIRTKEY
    VK_F6,          IDM_PREV_PANE,           VIRTKEY, SHIFT
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 200, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Demo MFC"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 75, 55, 50, 14
    CTEXT           "Wallpaper Engine DLL Demo MFC", IDC_STATIC, 10, 15, 180, 8
    CTEXT           "Interactive DLL API Tester", IDC_STATIC, 10, 30, 180, 8
END

